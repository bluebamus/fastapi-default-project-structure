# 이 파일을 `.env` 로 복사해 값을 채운다: cp .env.example .env
#
# 설정 검사(config.py, ADR-045) — 잘못된 설정은 기동 실패로 알려 준다(ENV=test 는 제외):
# - `.env` 가 없으면 ENV·비밀 키 3종·MYSQL_HOST/USER/PASSWORD/DATABASE 가 환경 변수로 모두
#   들어와야 한다(컨테이너 주입). 하나라도 없으면 기동하지 않는다.
# - 비밀 키 3종과 MYSQL_PASSWORD 가 아래 예시 값 그대로이거나 비어 있으면 **개발 환경에서도**
#   기동하지 않는다. 비밀 키는 32자 이상, access 와 refresh 는 서로 달라야 한다.
#   생성: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# - staging/production 은 추가로 DEBUG=true, LOG_LEVEL=DEBUG 를 거부한다.
# - 예전 설정 `ADMIN` 이 남아 있으면(이 파일의 옛 사본을 복사한 경우) test 외 모든 ENV 에서 기동을 거부한다 —
#   `ADMIN_DISABLED` 로 바뀌었다(아래 참조).
#
# 배포 전에 할 일(README 「운영 배포 체크리스트」와 같은 내용):
# 1. 프록시 뒤 배포면 TRUSTED_PROXY_HOPS 를 앞단 프록시 단 수로 정한다(아래 미들웨어 설정).
# 2. KST→UTC 시각 마이그레이션(리비전 a7c9e1f3b5d6)은 기존 MySQL 값이 +09:00 이라고 가정한다 —
#    다른 시간대였다면 적용 전에 리비전의 상수 _LEGACY_OFFSET 을 바꾸고, 적용 전 백업한다.
# 3. 첫 관리자는 scripts/create_superuser.py 로 만든다 — 관리 화면(/admin) 로그인 계정이기도 하다.
# 4. 관리 화면은 슈퍼유저 로그인이 필요하고, 그 세션은 Redis 서버 세션이다(SESSION_SECRET_KEY 가
#    세션 ID 를 Redis 키로 바꾸는 HMAC 키 — 바꾸면 모든 관리 세션이 끊긴다).
#    관리 화면을 쓰지 않으면 ADMIN_DISABLED=true.

# =============================================================================
# 애플리케이션 설정
# =============================================================================
# 프로젝트 이름 (Scalar 문서 제목, 관리자 페이지 제목에 표시). 코드 기본값과 같다.
PROJECT_NAME=FastAPI Project

# 애플리케이션 버전 (/health 응답의 version, OpenAPI info.version). 코드 기본값과 같다.
VERSION=0.1.0

# 프로젝트 설명 (Scalar 문서·/openapi.json 의 info.description).
# 미설정 시 config.API_DESCRIPTION(구조·트랜잭션 규칙을 적은 마크다운)이 쓰인다.
# 값을 주면 그 설명을 통째로 대체한다.
# DESCRIPTION=FastAPI 백엔드 템플릿

# DEBUG 모드 설정 (기본값: true)
# - true: DEBUG 로그 기본값, 없는 테이블 생성(MySQL 필요), /docs 활성화,
#         `python main.py` 의 reload, 500 응답 detail 에 예외 문자열
# - false: INFO 로그 기본값, 테이블 생성 안 함(Alembic 사용), /docs 비활성화
# Redis 연결 확인은 DEBUG 와 무관하게 항상 startup 조건이다.
DEBUG=true

# 관리 화면(SQLAdmin) 끄기 (기본값: false — 개발 우선 구조라 켜 두는 것이 의도된 기본값)
# - false: /admin 관리 화면 마운트. **활성 슈퍼유저 로그인 필요**(Bootstrap 로그인 화면).
#          계정은 `uv run python -m scripts.create_superuser --username admin --email admin@example.com`
#          세션 쿠키 admin_session 에는 세션 ID 만 있고 내용은 Redis 에 있다(아래 세션 설정).
# - true: 관리 화면을 완전히 끈다 — /admin 이하 404, sqladmin·세션 미들웨어를 만들지도 않고,
#         앱의 어떤 응답·기동 로그에도 관리 화면 경로가 나오지 않는다. 쓰지 않는 배포는 true.
# Note: DEBUG 설정과 독립적으로 동작한다. 설계·흐름은 docs/guides/workflows/admin-authentication.html.
#
# ⚠️ 예전 이름 ADMIN(true=켬)은 없앴다. ADMIN 이 환경 변수나 이 파일에 남아 있으면 기동을 거부한다 —
#    예전에 false(끔)였다면 그 줄을 지우고 ADMIN_DISABLED=true 를, true(켬)였다면 그 줄만 지운다.
ADMIN_DISABLED=false

# 환경 설정: development(개발), test(테스트), staging(스테이징), production(운영)
# 로그 출력 구성에 쓴다 — development/test 는 설정 타임존, staging/production 은 UTC 에
# ERROR 이상을 stderr 에도 쓴다. 헬스체크 응답에는 들어가지 않는다.
# 비밀 키 3종(ACCESS/REFRESH_TOKEN_SECRET_KEY, SESSION_SECRET_KEY)이 예시 값(`change-this` 포함·
# `your-` 시작·빈 값)이거나 32자 미만이거나 access==refresh 이면 test 외 모든 ENV 에서 기동을 거부한다.
ENV=development

# `python main.py` 직접 실행 시 개발 서버 바인딩 호스트/포트.
# 0.0.0.0 은 컨테이너/외부 접근 허용용 기본값. 민감한 환경에서는 127.0.0.1 로 제한하고
# 리버스 프록시(nginx 등) 뒤에 두는 것을 권장한다.
#
# ⚠️ 0.0.0.0 이면 관리 화면 로그인 페이지도 네트워크에 열린다(슈퍼유저 로그인 필요·레이트 리밋).
#    관리 화면을 쓰지 않으면 위 ADMIN_DISABLED=true 로 아예 없앤다.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =============================================================================
# 타임존 설정
# =============================================================================
# 애플리케이션 전역 타임존 (로그 시간, 데이터 생성 시간 등에 적용)
# 예시: Asia/Seoul, UTC, America/New_York
TIME_ZONE=Asia/Seoul

# =============================================================================
# 데이터베이스 설정 (MySQL)
# =============================================================================
# MySQL 서버 호스트 (IP 또는 도메인)
MYSQL_HOST=localhost

# MySQL 서버 포트
MYSQL_PORT=3306

# MySQL 접속 사용자명
MYSQL_USER=root

# MySQL 접속 비밀번호 (예시 값·빈 값이면 test 외 모든 ENV 에서 기동을 거부한다)
MYSQL_PASSWORD=change-this-mysql-password

# 사용할 데이터베이스 이름
MYSQL_DATABASE=fastapi_db

# =============================================================================
# DB 라우터 (읽기/쓰기 분리)
# =============================================================================
# 라우터 사용 여부 (기본값: false)
# - false: 모든 쿼리가 위에서 설정한 단일 서버로 나간다 (기존 동작)
# - true : 세션이 구문 성격에 따라 엔진을 자동 선택한다
#          · ORM flush / INSERT·UPDATE·DELETE → primary(쓰기)
#          · SELECT                            → replica(읽기)
#          · 쓰기가 일어난 세션의 이후 SELECT  → primary 고정 (아래 STICKY 참고)
# 구현: app/core/db/router.py
DB_ROUTER_ENABLED=false

# 읽기 복제본(replication) 사용 여부 (기본값: false)
# - true 로 켜려면 DB_ROUTER_ENABLED=true 와 MYSQL_REPLICA_HOSTS 지정이 함께 필요하다.
#   (모순된 조합은 애플리케이션 기동 시점에 에러로 차단된다)
# - false: 라우터를 켜도 replica 가 없으므로 읽기도 primary 로 나간다.
DB_REPLICATION_ENABLED=false

# 쓰기 이후 같은 세션의 읽기를 primary 에 고정 (기본값: true, 권장)
# 복제 지연(replication lag) 때문에 방금 커밋한 행이 replica 에서 아직 안 보일 수 있다.
# false 로 두면 읽기 분산은 늘어나지만 read-after-write 일관성을 잃는다.
DB_READ_STICKY_AFTER_WRITE=true

# replica 호스트 목록 (JSON 배열, "host" 또는 "host:port" 형식)
# 여러 대를 지정하면 세션 단위 라운드로빈으로 분산된다.
# 호스트는 IP 주소와 도메인 이름을 모두 쓸 수 있고, 포트를 생략하면 MYSQL_REPLICA_PORT 를 쓴다.
#   IPv4   : ["10.0.0.11", "10.0.0.12:3307"]
#   도메인 : ["replica-a.example.com", "replica-b.example.com:3307"]
#   IPv6   : ["[2001:db8::10]:3307", "[::1]"]   ← 반드시 대괄호로 감쌀 것
# 예: MYSQL_REPLICA_HOSTS=["10.0.0.11", "replica-b.example.com:3307"]
MYSQL_REPLICA_HOSTS=[]

# 포트를 명시하지 않은 replica 에 적용할 기본 포트
MYSQL_REPLICA_PORT=3306

# replica 전용 자격증명 (비워두면 위 primary 값을 그대로 재사용)
# 읽기 전용 계정을 따로 두면 실수로 replica 에 쓰는 사고를 DB 권한으로 막을 수 있다.
# MYSQL_REPLICA_USER=readonly
# MYSQL_REPLICA_PASSWORD=change-this-replica-password
# MYSQL_REPLICA_DATABASE=fastapi_db

# =============================================================================
# 마이그레이션 (Alembic)
# =============================================================================
# Alembic 이 사용할 DSN. 미설정 시 위 primary 설정에서 자동 유도한다
# (드라이버만 동기용 pymysql 로 치환 — Alembic 은 비동기 드라이버를 쓸 수 없다).
# 로컬/CI 에서 SQLite 등으로 갈아끼울 때만 명시한다.
# 마이그레이션은 항상 primary 에서 실행된다 (replica 는 읽기 전용).
# ALEMBIC_DATABASE_URL=sqlite:///./test.db

# =============================================================================
# Redis 설정 (startup 필수 연결 확인 + Celery broker/backend)
# Redis 에 닿지 못하면 DEBUG 값과 무관하게 서버가 기동하지 않는다.
# 서버는 6.2 이상이어야 한다(GETDEL) — startup 이 INFO server 로 확인하고 미만이면 멈춘다.
# =============================================================================
# Redis 서버 호스트
REDIS_HOST=localhost

# Redis 서버 포트
REDIS_PORT=6379

# Redis 데이터베이스 번호 (0-15)
REDIS_DB=0

# Redis 비밀번호 (설정하지 않으면 인증 없이 접속 — 비워 두는 것도 정상 구성이다)
REDIS_PASSWORD=

# =============================================================================
# CORS 설정 (Cross-Origin Resource Sharing)
# =============================================================================
# 허용할 Origin 목록 (JSON 배열 형식)
# 모든 Origin 허용: ["*"]
# 특정 Origin만 허용: ["http://localhost:3000", "https://example.com"]
CORS_ALLOW_ORIGINS=["*"]

# 자격 증명(쿠키, Authorization 헤더) 허용 여부
CORS_ALLOW_CREDENTIALS=false

# 허용할 HTTP 메서드 (JSON 배열 형식)
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]

# 허용할 HTTP 헤더 (JSON 배열 형식)
CORS_ALLOW_HEADERS=["*"]

# 브라우저(JS)에 노출할 응답 헤더 (JSON 배열 형식)
# CORS_EXPOSE_HEADERS=["X-Total-Count"]

# Preflight 요청 캐시 시간 (초)
CORS_MAX_AGE=600

# =============================================================================
# 로깅 설정
# =============================================================================
# 앱·`python main.py`·`uvicorn main:app`·Celery worker 가 모두 같은 형식으로 쓴다.
# 기본은 stdout/stderr 만이고(저장·rotation 은 Docker/Kubernetes·수집기), LOG_FILE_ENABLED=true 면
# 프로세스별 파일도 쓴다. 실제 쓰기는 QueueListener 스레드가 한다(NFR-009).
# staging/production 에서는 ERROR 이상이 stderr 로도 나가 오류만 따로 뽑을 수 있다.
# Django LOGGING 과의 대응·전체 표는 README "로깅" 절.

# 콘솔(stdout/stderr) 로그 출력.
# false: 콘솔 핸들러를 하나도 붙이지 않는다 — 앱 로그, `uvicorn main:app` CLI 의 uvicorn 로그,
#        Celery worker 의 콘솔 로그 모두. 파일 출력(LOG_FILE_ENABLED·Celery --logfile)은 그대로 남는다.
#        콘솔이 꺼지면 기동 때 stderr 에 경고 한 줄이 나온다(파일도 꺼져 있으면 앱 로그는 버려진다).
LOG_CONSOLE_ENABLED=true

# SQL 본문과 바인딩 파라미터를 로그로 내보낼지 여부.
# 기본값 false 는 보안 요구다 — DEBUG=true 면 로그 레벨이 DEBUG 가 되고, 그 상태에서
# SQLAlchemy/드라이버는 실행한 SQL 과 **값**(비밀번호 해시·토큰·검색어 포함)을 그대로
# 찍는다. 쿼리를 눈으로 봐야 할 때만 잠깐 켠다. 운영에서는 절대 켜지 말 것.
LOG_SQL_ECHO_ENABLED=false

# 로그 레벨 설정 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# 미설정 시 DEBUG 설정에 따라 자동 결정:
#   - DEBUG=true → DEBUG 레벨
#   - DEBUG=false → INFO 레벨
# 명시적 설정 시 해당 값이 우선 적용됨
# LOG_LEVEL=DEBUG
# LOG_CONSOLE_LEVEL=DEBUG
# LOG_FILE_LEVEL=INFO

# 헤더(app=)별 최소 레벨 — Django LOGGING["loggers"][이름]["level"] 자리.
# 키는 헤더 이름: 기능명(blog·user…)·core·celery·utils·migrations·app, 외부 라이브러리는
# celery(celery·kombu)·uvicorn·sqlalchemy·alembic·ext. 값은 DEBUG/INFO/WARNING/ERROR/CRITICAL.
# 지정 없는 헤더는 LOG_LEVEL 을 따른다. 잘못된 형식·레벨은 기동 오류, 모르는 헤더는 경고만.
# LOG_APP_LEVELS=blog=DEBUG,celery=INFO,sqlalchemy=WARNING

# 로그 출력 형식 — 포매터의 fmt(str.format 스타일 '{필드}')와 시각 형식(strftime).
# 미설정 시 아래 기본값이다. 필드는 LogRecord 속성({levelname}·{name}·{module}·{funcName}·{lineno}·
# {message} 등)과 {tzname}·{appname}·{classname}. 모르는 필드·괄호 불일치·빈 날짜 형식은 기동 시 오류.
# 필수 필드: {asctime}·{levelname}·{appname}·{module}·{classname}·{funcName}·{message} — 빠지면 기동 오류.
# 시각: development 는 날짜 형식 뒤에 밀리초(.123)가 붙고, staging/production 은 UTC 로 렌더한다.
# 앱·uvicorn CLI·Celery 의 콘솔과 파일이 모두 이 형식을 쓴다(콘솔은 CONSOLE, 파일은 FILE).
# 비밀값 마스킹(DSN 계정·password=·Authorization·설정 비밀값 원문)은 형식과 무관하게 적용된다.
# LOG_CONSOLE_FORMAT=[{asctime} {tzname}] {levelname:5} [app={appname}] [{module}:{classname}:{funcName}:{lineno}] {message}
# LOG_FILE_FORMAT=[{asctime} {tzname}] {levelname:5} [app={appname}] [{module}:{classname}:{funcName}:{lineno}] {message}
# LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
# 예) LOG_CONSOLE_FORMAT={asctime} {levelname} {appname} {module}.{classname}.{funcName}: {message}
#     LOG_DATE_FORMAT=%H:%M:%S

# 파일 로그 — 켜면 LOG_DIR 아래에 프로세스별로 쓴다:
#   웹(앱·uvicorn) app.log + error.log(ERROR 이상) / Celery worker celery.log + celery-error.log
# 매일 자정(로그 시각과 같은 시간대 — production·staging 은 UTC)에 app.log.YYYY-MM-DD 로 넘기고,
# 하루 안에서 LOG_MAX_SIZE_MB 를 넘으면 app.log.YYYY-MM-DD.1·.2… 로 나눈다.
# LOG_RETENTION_DAYS 보다 오래된 날짜의 파일(분할 포함)은 교체 때 지운다. 0 = 지우지 않음, 음수는 오류.
# 주의: uvicorn --workers 2 이상(또는 여러 프로세스가 같은 LOG_DIR)이면 회전이 엇갈린다 —
#       그때는 파일을 끄고 콘솔(stdout) + 수집기/logrotate 를 쓴다.
LOG_FILE_ENABLED=false
# LOG_DIR=logs
# LOG_MAX_SIZE_MB=10
# LOG_RETENTION_DAYS=30

# =============================================================================
# 미들웨어 설정
# =============================================================================
# 접속 로그 수집 활성화
# true: 제외 경로·확장자를 뺀 요청마다 접속 로그를 DB(user_access_logs)에 저장
#       (background 세션 풀, 동시 256건 초과분은 버린다)
ACCESS_LOG_ENABLED=true

# 접속 로그 수집 제외 경로 (JSON 배열 형식)
# 헬스체크, 정적 파일 등 로깅이 불필요한 경로 (정확히 일치)
# 기본값: ["/health", "/docs", "/redoc", "/openapi.json", "/favicon.ico"]
# ACCESS_LOG_EXCLUDE_PATHS=["/health", "/docs", "/openapi.json", "/admin"]

# 접속 로그 수집 제외 확장자 (JSON 배열 형식)
# 정적 파일 요청은 로깅에서 제외
# ACCESS_LOG_EXCLUDE_EXTENSIONS=[".css", ".js", ".ico", ".png", ".jpg"]

# 접속 로그에서 값을 가릴 쿼리스트링 키 (JSON 배열, 대소문자 무시) — 값은 `***` 로 저장한다
# 기본값: ["password", "token", "access_token", "refresh_token", "secret", "api_key", "code"]
# ACCESS_LOG_SENSITIVE_QUERY_KEYS=["password", "token", "access_token", "refresh_token", "secret", "api_key", "code"]

# 접속 로그 보존 일수 — Celery beat 가 매일 03:30(TIME_ZONE 기준) 이보다 오래된 행을 지운다
# 기본값: 365(1년). 0: 지우지 않는다. 음수는 기동 시 검증 오류
# beat 를 띄워야 동작한다: uv run celery -A app.celery.app beat --loglevel=INFO
ACCESS_LOG_RETENTION_DAYS=365

# 앞단 신뢰 프록시 홉 수 — 클라이언트 IP 를 X-Forwarded-For 의 어디서 읽을지 정한다
# 0(기본): X-Forwarded-For·X-Real-IP 를 보지 않고 직접 연결한 주소만 쓴다(헤더는 위조 가능)
# N: X-Forwarded-For 의 오른쪽에서 N번째 값(신뢰 프록시 N단이 덧붙인 값)
#    nginx·로드밸런서 1단 뒤라면 1. 실제 단수보다 크게 잡으면 다시 위조할 수 있게 된다
# ⚠️ 배포 전에 정한다: 프록시 뒤인데 0 이면 모든 클라이언트가 프록시 IP 하나로 보여 접속 로그와
#    로그인 레이트 리밋(API·/admin)이 전체 사용자를 한 사람으로 취급한다(한 명의 실패가 모두를 막는다).
TRUSTED_PROXY_HOPS=0

# =============================================================================
# 세션 설정
# config.SessionSettings 로 로드됨. API 인증은 JWT(Bearer) 이고 쿠키 세션은 관리 화면(/admin)
# 로그인만 쓴다 — 관리 세션은 Redis 서버 세션이고 쿠키(admin_session, path=/admin)에는 무작위
# 세션 ID 만 있다. 로그아웃·강등·비활성화·삭제 시 서버에서 바로 폐기된다.
# 관리 세션 만료는 아래 ADMIN_SESSION_* 가 정한다. SESSION_COOKIE_NAME 은 관리 화면 쿠키에 쓰이지 않고,
# 접속 로그가 session_id 로 기록할 쿠키 이름으로 쓰인다(인증에는 쓰지 않는다).
# =============================================================================
# 세션 쿠키 이름
SESSION_COOKIE_NAME=session

# 관리 세션 키 — 세션 ID 를 Redis 키(admin:sess:<HMAC-SHA256>)로 바꾼다. 아래 값은 예시(placeholder)라
# 그대로 두면 기동을 거부한다(test 제외). 32자 이상. 바꾸면 모든 관리 화면 세션이 무효가 된다(다시 로그인).
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change-this-session-secret-key

# 관리 세션 절대 만료(초, 기본값: 28800 = 8시간, 최소 60) — 로그인 시각 기준, 연장되지 않는다.
# ADMIN_SESSION_MAX_AGE_SECONDS=28800

# 관리 세션 미사용 만료(초, 기본값: 1800 = 30분, 최소 60, 절대 만료 이하) — 요청마다 다시 잰다.
# ADMIN_SESSION_IDLE_SECONDS=1800

# =============================================================================
# JWT 토큰 · 인증 레이트 리밋 설정
# ✅ 인증(app/core/security, app/features/auth)에서 사용됨 — config.JWTSettings 로 로드. 운영 시 키를 교체하세요.
# =============================================================================
# Access·Refresh Token 서명 키 — 아래 값은 예시(placeholder)라 그대로 두면 기동을 거부한다(test 제외).
# 32자 이상, 두 키는 서로 달라야 한다(같으면 기동 거부). 키마다 따로 생성:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_SECRET_KEY=change-this-access-token-secret-key
REFRESH_TOKEN_SECRET_KEY=change-this-refresh-token-secret-key

# Access Token 만료 시간 (분, 기본값: 15분). access 는 서버에서 폐기할 수 없으므로 짧게 둔다.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token 만료 시간 (일, 기본값: 7일). 회전 기록·폐기 표시(Redis)도 같은 TTL 을 쓴다.
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 알고리즘 — HS256 / HS384 / HS512 만 허용 (기본값: HS256)
# JWT_ALGORITHM=HS256

# 발급자(iss)·대상(aud) — 검증 시 일치를 요구한다. 같은 키를 쓰는 다른 서비스와 겹치지 않게 정한다.
# JWT_ISSUER=fastapi-default-project-structure
# JWT_AUDIENCE=fastapi-default-project-structure-api

# exp·nbf·iat 검증의 시계 오차 허용(초, 기본값: 10)
# JWT_LEEWAY_SECONDS=10

# 로그인 레이트 리밋(Redis 고정 창). IP+사용자명 키는 성공하면 지운다. 초과 시 429 + Retry-After.
# 관리 화면(/admin) 로그인도 같은 한도를 쓰되 카운터는 따로 센다(키 접두사 admin:rl:login:).
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_IP_MAX_ATTEMPTS=20
# AUTH_LOGIN_WINDOW_SECONDS=60

# 회원가입 레이트 리밋(IP 단위)
# AUTH_REGISTER_MAX_ATTEMPTS=5
# AUTH_REGISTER_WINDOW_SECONDS=3600
